               <layout class="QGridLayout" name="discoverySetupGL">
                <item row="0" column="0" colspan="4">
                 <widget class="QLabel" name="discoveryInfoLB">
                  <property name="text">
                   <string>Screen the top candidates from the latest Circuit Explorer result by controlled single-neuron ablation. Graph score is only a candidate-ranking heuristic; causal rank is based on the simulated effect on TARGET/MN9.</string>
