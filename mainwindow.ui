    <layout class="QVBoxLayout" name="verticalLayout_7">
     <item>
      <widget class="QGroupBox" name="viewGB">
       <property name="title">
        <string>3D view</string>
       </property>
       <layout class="QVBoxLayout" name="verticalLayout_8">
        <item>
         <layout class="QHBoxLayout" name="horizontalLayout_2">
          <item>
           <layout class="QFormLayout" name="formLayout">
            <item row="0" column="1">
             <widget class="QCheckBox" name="lightingCB">
              <property name="toolTip">
               <string>Enable soft OpenGL lighting. The renderer uses a high ambient component so thin neurites remain visible.</string>
              </property>
              <property name="text">
               <string>Lighting</string>
              </property>
              <property name="checked">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item row="1" column="1">
             <widget class="QCheckBox" name="smoothMeshCB">
              <property name="toolTip">
               <string>Antialias QwtPlot3D mesh lines. Relevant mainly to mesh and wireframe modes.</string>
              </property>
              <property name="text">
               <string>Smooth mesh</string>
              </property>
              <property name="checked">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item row="2" column="1">
             <widget class="QCheckBox" name="orthographicCB">
              <property name="toolTip">
               <string>Switch between perspective and orthographic projection. Orthographic is useful for comparing morphology without perspective size distortion.</string>
              </property>
              <property name="text">
               <string>Orthographic</string>
              </property>
             </widget>
            </item>
            <item row="3" column="1">
             <widget class="QCheckBox" name="grid3DCB">
              <property name="toolTip">
               <string>Show major grid lines on floor/back/left planes. Useful for spatial reference, disabled by default to avoid clutter.</string>
              </property>
              <property name="text">
               <string>Major grid</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
