    <string>Help - Italiano</string>
   </property>
   <property name="toolTip">
    <string>Open the Italian HTML manual in the system default browser</string>
   </property>
   <property name="shortcut">
    <string>F1</string>
   </property>
  </action>
  <action name="actionHelpEnglish">
   <property name="icon">
    <iconset resource="drosofila.qrc">
     <normaloff>:/drosofila/images/United Kingdom.png</normaloff>:/drosofila/images/United Kingdom.png</iconset>
   </property>
   <property name="text">
    <string>Help - English (UK)</string>
   </property>
   <property name="toolTip">
    <string>Open the English (UK) HTML manual in the system default browser</string>
   </property>
   <property name="shortcut">
    <string>Shift+F1</string>
   </property>
  </action>
  <action name="actionDataCredits">
   <property name="icon">
    <iconset resource="drosofila.qrc">
     <normaloff>:/drosofila/images/help.png</normaloff>:/drosofila/images/help.png</iconset>
   </property>
   <property name="text">
    <string>Data Sources &amp; Credits...</string>
   </property>
   <property name="toolTip">
    <string>Open acknowledgements, data sources, citations and data licence notes</string>
   </property>
  </action>
  <action name="actionLicense">
   <property name="icon">
    <iconset resource="drosofila.qrc">
     <normaloff>:/drosofila/images/license.png</normaloff>:/drosofila/images/license.png</iconset>
   </property>
   <property name="text">
    <string>License...</string>
   </property>
   <property name="toolTip">
    <string>Show the Drosofila Live freeware licence in the internal text browser</string>
   </property>
  </action>
 </widget>
 <layoutdefault spacing="6" margin="11"/>
 <customwidgets>
  <customwidget>
   <class>QwtPlot</class>
   <extends>QFrame</extends>
   <header>qwt_plot.h</header>
  </customwidget>
 </customwidgets>
 <resources>
  <include location="drosofila.qrc"/>
 </resources>
 <connections>
  <connection>
   <sender>actionExit</sender>
   <signal>triggered(bool)</signal>
   <receiver>MainWindow</receiver>
   <slot>close()</slot>
   <hints>
    <hint type="sourcelabel">
     <x>-1</x>
     <y>-1</y>
    </hint>
    <hint type="destinationlabel">
     <x>20</x>
     <y>20</y>
    </hint>
   </hints>
  </connection>
  <connection>
   <sender>actionViewCircuitGraph</sender>
   <signal>triggered(bool)</signal>
   <receiver>circuitGraphDockWidget</receiver>
   <slot>setVisible(bool)</slot>
   <hints>
    <hint type="sourcelabel">
     <x>-1</x>
     <y>-1</y>
    </hint>
    <hint type="destinationlabel">
     <x>20</x>
     <y>20</y>
    </hint>
   </hints>
  </connection>
  <connection>
   <sender>circuitGraphDockWidget</sender>
   <signal>visibilityChanged(bool)</signal>
   <receiver>actionViewCircuitGraph</receiver>
   <slot>setChecked(bool)</slot>
   <hints>
    <hint type="sourcelabel">
     <x>20</x>
     <y>20</y>
    </hint>
    <hint type="destinationlabel">
     <x>-1</x>
     <y>-1</y>
    </hint>
   </hints>
  </connection>
  <connection>
   <sender>actionViewLog</sender>
   <signal>triggered(bool)</signal>
   <receiver>logDockWidget</receiver>
   <slot>setVisible(bool)</slot>
   <hints>
    <hint type="sourcelabel">
     <x>-1</x>
     <y>-1</y>
    </hint>
    <hint type="destinationlabel">
     <x>20</x>
     <y>20</y>
    </hint>
   </hints>
  </connection>
  <connection>
   <sender>logDockWidget</sender>
   <signal>visibilityChanged(bool)</signal>
   <receiver>actionViewLog</receiver>
   <slot>setChecked(bool)</slot>
   <hints>
    <hint type="sourcelabel">
     <x>20</x>
     <y>20</y>
    </hint>
    <hint type="destinationlabel">
     <x>-1</x>
     <y>-1</y>
    </hint>
   </hints>
  </connection>
 </connections>
