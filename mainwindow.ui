                  </property>
                 </widget>
                </item>
                <item row="3" column="1">
                 <widget class="QComboBox" name="discoverySelectionCB">
                  <property name="toolTip">
                   <string>Global Top N uses the Explorer ranking directly. Top N per depth preserves strong shallower candidates when a deeper exploration introduces many new neurons.</string>
                  </property>
