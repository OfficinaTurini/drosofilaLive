                 </widget>
                </item>
                <item row="2" column="2">
                 <widget class="QPushButton" name="discoveryRunPB">
                  <property name="toolTip">
                   <string>Runs controlled Reference-vs-Ablation screening for the selected Explorer candidates. Screen replicates = 1 is the fast historical mode; values greater than 1 perform a multi-seed coarse screen.</string>
                  </property>
                  <property name="text">
                   <string>Screen Explorer</string>
                  </property>
                 </widget>
                </item>
                <item row="2" column="3">
                 <widget class="QPushButton" name="discoveryStopPB">
                  <property name="toolTip">
                   <string>Requests a cooperative stop. Screening/validation finish the current comparison; Discovery epistasis finishes the current WT/A OFF/B OFF/A+B OFF replicate.</string>
                  </property>
