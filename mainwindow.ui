              </property>
              <property name="alignment">
               <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
              </property>
             </widget>
            </item>
            <item row="0" column="1">
             <widget class="QComboBox" name="surfaceStyleCB">
              <property name="toolTip">
               <string>Filled is the clean default for thin neurites. Filled + mesh overlays polygon edges; Wireframe and Hidden line are useful for geometry inspection.</string>
